      <aliases enabled='yes' />
      <column aggregation='None' caption='Ai Replacement Score (bin)' datatype='integer' name='[Ai Replacement Score (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[ai_replacement_score]' peg='0' size='5' />
      </column>
      <column caption='Risk % Category' datatype='string' name='[Calculation_1746130062719590418]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([automation_risk_percent]) &lt; 30 THEN &quot;Low&quot;&#10;ELSEIF AVG([automation_risk_percent]) &gt; 60 THEN &quot;High&quot;&#10;ELSE &quot;Medium&quot;&#10;END' />
      </column>
      <column caption='High Risk ' datatype='integer' name='[Calculation_1746130062752550956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [automation_risk_category] = &quot;high&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Shape' datatype='integer' name='[Calculation_1746130063100764289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Reskilling Score' datatype='string' name='[Risk % Category (copy)_1746130063049216121]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([reskilling_urgency_score]) &lt; 30 THEN &quot;Low&quot;&#10;ELSEIF AVG([automation_risk_percent]) &gt; 60 THEN &quot;High&quot;&#10;ELSE &quot;Medium&quot;&#10;END' />
      </column>
      <column aggregation='None' datatype='integer' name='[Skill Demand Growth Percent (bin)]' role='dimension' type='quantitative'>
